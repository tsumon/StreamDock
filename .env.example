# Copy to .env and fill in. Never commit the real file.

PORT=9090
DB_PATH=streamdock.db

# HMAC key for panel sessions. Must be at least 32 bytes.
# If unset, the process generates an ephemeral key (sessions die on restart).
JWT_SECRET=

# Required to create the first administrator. Must be at least 32 bytes.
# If unset on an empty database, the process generates one and prints it at startup.
SETUP_TOKEN=

# Management panel bind address. Default is loopback.
# Use 0.0.0.0 only behind a reverse proxy, and set ALLOW_INSECURE_HTTP=true
# if the panel itself is not serving HTTPS.
PANEL_BIND_ADDR=127.0.0.1
# ALLOW_INSECURE_HTTP=true
