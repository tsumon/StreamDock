# Copy to .env for docker compose / local runs. Never commit the real file.

# Required for stable panel sessions (at least 32 bytes).
JWT_SECRET=change-me-to-a-long-random-string-32b

# Optional. First administrator setup (at least 32 bytes).
# If empty on a fresh DB, the process generates one and prints it at startup.
SETUP_TOKEN=

PORT=9090
DB_PATH=streamdock.db

# Host / bare-metal default is loopback. Docker image forces 0.0.0.0.
PANEL_BIND_ADDR=127.0.0.1
# ALLOW_INSECURE_HTTP=true
